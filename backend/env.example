# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens (must be long, random, and unique per environment)
# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ─────────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────────

# JWT token expiration time in hours
TOKEN_EXPIRE_HOURS=24

# Secure cookies (set to true in production with HTTPS)
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────

# Backend port
PORT=8765

# Host binding address (use 127.0.0.1 for local-only access)
BIND_HOST=0.0.0.0

# Environment mode (development | production)
ENV=development

# Logging level (debug | info | warning | error)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────

# SQLite database file path (used for development / small deployments)
DB_PATH=erp.db