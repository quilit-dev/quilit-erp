# Railway environment variables — single-service deployment.
#
#   Cloudflare (DNS/TLS/CDN) → Railway (this Docker image: SPA + API)
#                              → Railway PostgreSQL + Cloudflare R2
#
# Set these in the Railway service → Variables tab. Do NOT commit real values;
# this file documents the shape only.
#
# ── Database ────────────────────────────────────────────────────────────────
DB_BACKEND=postgres
# MUST be set on the APPLICATION service, not just the database service.
# The reference form below only resolves if your Postgres service is named
# exactly "Postgres" — check the service name in Railway and match it, or paste
# the literal connection string from the Postgres service's Variables tab.
# Prefer the internal/private hostname (*.railway.internal) over the public
# proxy: it is faster and avoids egress charges.
# If this is empty the app now fails fast with an explanatory error rather than
# silently trying localhost:5432.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Run the schema bootstrap once per deploy (idempotent). In single-tenant mode
# this creates/upgrades the schema; in schema-tenancy it creates the shared
# public catalogs (tenants + platform_admins) only.
RUN_BOOTSTRAP=1

# ── Security ────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
# Changing this invalidates every existing session token.
SECRET_KEY=__CHANGE_ME__generate_with_token_hex_32__

# Railway/Cloudflare terminate TLS, so the session cookie must be Secure.
COOKIE_SECURE=true

# Same-origin deployment (the container serves the SPA and the API together),
# so CORS is not exercised in normal use. Kept explicit for API clients.
ALLOWED_ORIGINS=https://app.quilit.dev

TOKEN_EXPIRE_HOURS=24

# ── Tenancy ─────────────────────────────────────────────────────────────────
# single = one company on this deployment.
# schema = many companies, one isolated PostgreSQL schema each, reached at
#          <slug>.quilit.dev. Requires the wildcard DNS record.
TENANCY=schema

# ── File storage (Cloudflare R2) ────────────────────────────────────────────
# Keeps uploaded PDFs/Word/Excel OUT of PostgreSQL — smaller backups, cheaper
# database plans, and R2 charges no egress. boto3 is already in
# requirements-cloud.txt and is imported lazily.
STORAGE=s3
S3_BUCKET=quilit-erp-docs
S3_ENDPOINT_URL=https://__ACCOUNT_ID__.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=__CHANGE_ME__
S3_SECRET_ACCESS_KEY=__CHANGE_ME__

# ── Runtime sizing ──────────────────────────────────────────────────────────
# At ~10 customers x <10 users this load is tiny. Redis and a background worker
# add moving parts and cost without buying anything at this scale — add them
# only when a real bottleneck shows up.
CACHE=none
JOBS=inline

# ── Concurrency, and the one sum that must not be exceeded ──────────────────
# Requests are served by WEB_CONCURRENCY gunicorn worker PROCESSES, and each
# worker keeps its OWN pool of up to DB_POOL_MAX PostgreSQL connections. So the
# database sees, at most:
#
#     WEB_CONCURRENCY x DB_POOL_MAX x replicas
#
# and that total must stay comfortably under the server's `max_connections`
# (check it: SHOW max_connections; commonly 100). Leave headroom for psql,
# backups and migrations. Exceeding it does not slow requests down — it fails
# them outright with "too many clients already", for everyone at once.
#
# 4 x 8 = 32 per replica: room to grow to two replicas and still sit under 100.
# Raising WEB_CONCURRENCY without lowering DB_POOL_MAX is what overruns it.
WEB_CONCURRENCY=4
DB_POOL_MAX=8
# Kept warm so the first request of a quiet period does not pay the handshake.
DB_POOL_MIN=1
# Seconds a request waits for a free connection before erroring. Queuing
# briefly under a burst beats failing.
DB_POOL_TIMEOUT=15

# Structured JSON logs so Railway's log viewer can parse/filter them.
LOG_FORMAT=json
