# ── ERP production environment (Phase 5) ─────────────────────────────────────
# Copy to `.env` next to docker-compose.yml and fill in. NEVER commit the real
# .env. Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

# ── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=__CHANGE_ME__generate_with_token_hex_32__
# Public hostname Caddy serves + provisions TLS for. Use ":80" for a local
# HTTP-only smoke test. For schema-per-tenant, point a wildcard *.erp.example.com
# at this host and set DOMAIN to the apex or a wildcard label.
DOMAIN=erp.example.com
# Browser origins allowed to call the API with credentials (comma-separated).
ALLOWED_ORIGINS=https://erp.example.com
COOKIE_SECURE=true

# ── Database (Postgres) ──────────────────────────────────────────────────────
POSTGRES_USER=erp
POSTGRES_PASSWORD=__CHANGE_ME__strong_password__
POSTGRES_DB=erp
# DATABASE_URL is assembled by docker-compose from the three values above.

# ── Tenancy ──────────────────────────────────────────────────────────────────
# single  = one company per deployment (the default; simplest).
# schema  = multi-tenant, one Postgres schema per company (provision via /api/platform).
TENANCY=single

# ── Object storage (attachments) ─────────────────────────────────────────────
# db = keep files in the database (no external storage). s3 = S3/R2/MinIO.
STORAGE=db
# S3_BUCKET=erp-files
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com   # R2/MinIO; omit for AWS
# S3_REGION=auto
# S3_ACCESS_KEY_ID=__CHANGE_ME__
# S3_SECRET_ACCESS_KEY=__CHANGE_ME__

# ── Cache + background jobs ───────────────────────────────────────────────────
# none/inline = synchronous (default). redis/rq = use the Redis service.
CACHE=redis
JOBS=rq
# REDIS_URL is set by docker-compose to the redis service.

# ── Email (SMTP) — outbound invoices/quotations + overdue reminders ──────────
# Off until EMAIL_ENABLED=true AND SMTP resolves (these vars, or per-tenant in
# Settings → Email). Setting creds here keeps them out of the database (cloud).
# EMAIL_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey-or-username
# SMTP_PASSWORD=__CHANGE_ME__
# SMTP_USE_TLS=1
# SMTP_FROM=billing@yourcompany.com
# SMTP_FROM_NAME=Your Company

# ── Scheduler — periodic tasks (overdue-invoice reminders, …) ────────────────
# Docker stack: the dedicated `scheduler` service sweeps every SCHEDULER_TICK
# seconds (default 3600).
# SCHEDULER_TICK=3600
#
# Single-service hosts (e.g. Render) that can't run a separate scheduler
# process: set CRON_TOKEN, then have an external cron POST on a schedule to
#   https://<your-app>/api/cron/run   with header  X-Cron-Token: <token>
# (also keeps a free instance awake). Leave unset to disable the endpoint.
# CRON_TOKEN=__CHANGE_ME_to_a_long_random_string__

# ── Backups (optional offsite copy of the nightly pg_dump) ───────────────────
# BACKUP_S3_BUCKET=erp-backups
# BACKUP_RETENTION_DAYS=14
