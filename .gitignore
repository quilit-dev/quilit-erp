# Secrets — NEVER commit
.secret_key
backend/.secret_key
backend/.env
# Root .env used by docker-compose (the production secrets file). The committed
# template is .env.production.example.
/.env

# Databases
*.db
*.db-wal
*.db-shm
backend/erp.db
erp.db

# Backups
backups/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Vite build output
static/

# Build / packaging artifacts
build/
dist/

# Logs & temp files
startup_log.txt
*.bak
backend/_dbdump.txt
backend/_tables.txt
_server_out.log
_server_err.log

# Front-end dependencies
frontend_src/node_modules/
node_modules/
# pnpm's content-addressed package store. Thousands of files, and it sat
# untracked-but-not-ignored long enough that one `git add -A` would have
# committed the lot.
.pnpm-store/

# Manual: built static site (source lives in docs/manual/)
static-manual/

# Tooling
.claude/

# OS
.DS_Store
Thumbs.db
# /graphify scratch output — 23MB of generated graphs, not source
graphify-out/

# The site time-clock agent's local files. config.ini holds a token that can
# WRITE attendance into a live tenant -- it must never be committed. state.json
# and agent.log are per-installation runtime files.
agent/timeclock/config.ini
agent/timeclock/state.json
agent/timeclock/agent.log*
agent/timeclock/__pycache__/
agent/timeclock/dist/
agent/timeclock/build/
agent/timeclock/release/

# Compiled Windows installers (45 MB of .exe). The desktop build is gone;
# this directory is only what it left behind on the build machine.
installer/
